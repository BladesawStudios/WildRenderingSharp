<Project>
  <!--
    Shared by every project in this repository. Hosts that pull the library in as a submodule do
    not see this file unless their own project sits under this directory, so nothing here may be
    something a host's build depends on - see build/KingRenderingSharp.targets for that.
  -->
  <!-- A props file above this repository (one checking out several libraries side by side) still applies to the library's own projects, and not to the vendored libraries, which keep their own settings. -->
  <PropertyGroup>
    <KrsParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))</KrsParentProps>
  </PropertyGroup>
  <Import Project="$(KrsParentProps)" Condition="'$(KrsParentProps)' != '' And !$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)vendor'))" />
  <!-- A host that treats its own warnings as errors does not do so for this library's code, which is built as it is here. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- BfresLibrary, BntxSharp, McSharp, PtclSharp, TxtgSharp and their TexSharp keep their own target frameworks and language settings. -->
  <PropertyGroup Condition="!$(MSBuildProjectFullPath.Contains('BfresLibrary')) And !$(MSBuildProjectFullPath.Contains('BntxSharp')) And !$(MSBuildProjectFullPath.Contains('McSharp')) And !$(MSBuildProjectFullPath.Contains('TexSharp')) And !$(MSBuildProjectFullPath.Contains('TxtgSharp')) And !$(MSBuildProjectFullPath.Contains('PtclSharp'))">
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>BladesawStudios</Authors>
    <Product>KingRenderingSharp</Product>
    <RepositoryUrl>https://github.com/BladesawStudios/KingRenderingSharp</RepositoryUrl>
  </PropertyGroup>
</Project>
