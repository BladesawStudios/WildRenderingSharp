<Project>

  <!--
    Import this from a host project that references src/WildRenderingSharp/WildRenderingSharp.csproj:

      <Import Project="path\to\WildRenderingSharp\build\WildRenderingSharp.targets" />

    The renderer needs two helpers that it deliberately does NOT reference, because each would pull
    an assembly into the host's process that clashes with one the host very likely has already:

      aampreader\   WildRenderingSharp.AampReader - AAMP parsing through AampLibrary, which needs
                    Syroot.* 5.x while anything reading BFRES needs Syroot.* 2.x. Loaded at runtime
                    into its own AssemblyLoadContext (WildRenderingSharp.Cloth.Format.IsolatedAamp).
                    Always built.

      wrs-prepare\  WildRenderingSharp.Preparation - the offline model preparer, run as a child
                    process by WildRenderingSharp.Hosting.OutOfProcessPreparer. It carries
                    ShaderLibrary's own vendored BfresLibrary build, which is not the one a host
                    building BfresLibrary from source has. Built when WrsOutOfProcessPreparer is
                    true (the default). A host that references WildRenderingSharp.Preparation
                    directly and prepares in-process can set it to false.

    Both land beside the host's executable on build, and beside the published executable on publish.
  -->

  <PropertyGroup>
    <WrsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</WrsRoot>
    <WrsAampReaderProject>$(WrsRoot)\src\WildRenderingSharp.AampReader\WildRenderingSharp.AampReader.csproj</WrsAampReaderProject>
    <WrsPreparationProject>$(WrsRoot)\src\WildRenderingSharp.Preparation\WildRenderingSharp.Preparation.csproj</WrsPreparationProject>
    <WrsOutOfProcessPreparer Condition="'$(WrsOutOfProcessPreparer)' == ''">true</WrsOutOfProcessPreparer>
  </PropertyGroup>

  <!--
    Built normally (into the helper project's own bin/), then copied - rather than built straight
    into the host's folder with an OutputPath override. An override is a global property, so it
    would flow on to every project the helper references and rebuild each of them a second time,
    into the host's folder, beside the host's own copies of the same assemblies.
    RemoveProperties keeps the host's own global properties (a RuntimeIdentifier, a publish's
    SelfContained, ...) from being forced onto projects that were never meant to take them.

    The helpers are not in the host's restore graph (they are deliberately not references), so they
    are restored here first. The restore runs under an extra global property so it is a separate
    evaluation from the build that follows - otherwise the build would reuse an evaluation made
    before restore had written the files it imports, and fail on a fresh clone with
    "project.assets.json not found".
  -->
  <Target Name="WrsBuildHelpers" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(WrsAampReaderProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);_WrsRestoreEvaluation=true"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir;OutDir;OutputPath;_IsPublishing" />
    <MSBuild Projects="$(WrsPreparationProject)" Targets="Restore" Condition="'$(WrsOutOfProcessPreparer)' == 'true'"
             Properties="Configuration=$(Configuration);_WrsRestoreEvaluation=true"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir;OutDir;OutputPath;_IsPublishing" />

    <MSBuild Projects="$(WrsAampReaderProject)" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir;OutDir;OutputPath;_IsPublishing">
      <Output TaskParameter="TargetOutputs" ItemName="_WrsAampReaderOutput" />
    </MSBuild>
    <MSBuild Projects="$(WrsPreparationProject)" Targets="Build" Condition="'$(WrsOutOfProcessPreparer)' == 'true'"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir;OutDir;OutputPath;_IsPublishing">
      <Output TaskParameter="TargetOutputs" ItemName="_WrsPreparationOutput" />
    </MSBuild>

    <PropertyGroup>
      <_WrsAampReaderDir>@(_WrsAampReaderOutput->'%(RootDir)%(Directory)')</_WrsAampReaderDir>
      <_WrsPreparationDir Condition="'@(_WrsPreparationOutput)' != ''">@(_WrsPreparationOutput->'%(RootDir)%(Directory)')</_WrsPreparationDir>
    </PropertyGroup>
    <ItemGroup>
      <_WrsAampReaderFiles Include="$(_WrsAampReaderDir)**\*" />
      <_WrsPreparationFiles Include="$(_WrsPreparationDir)**\*" Condition="'$(_WrsPreparationDir)' != ''" />
    </ItemGroup>

    <Copy SourceFiles="@(_WrsAampReaderFiles)" DestinationFiles="@(_WrsAampReaderFiles->'$(TargetDir)aampreader\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WrsPreparationFiles)" DestinationFiles="@(_WrsPreparationFiles->'$(TargetDir)wrs-prepare\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    On publish. The AAMP reader is loaded into the host's own process, so the build output serves
    whatever the host is. The preparer is a process of its own: beside a framework-dependent host
    the build output is right, but beside a SELF-CONTAINED host - one handed to people who have no
    .NET installed - a framework-dependent preparer would not start. So for those it is published
    self-contained for the host's runtime identifier (not single-file: ShaderLibrary's native
    helpers and MeshCodec's decoder have to sit beside it as plain files).
  -->
  <Target Name="WrsPublishHelpers" AfterTargets="Publish" DependsOnTargets="WrsBuildHelpers">
    <PropertyGroup>
      <_WrsSelfContainedPreparer Condition="'$(WrsOutOfProcessPreparer)' == 'true' And '$(SelfContained)' == 'true' And '$(RuntimeIdentifier)' != ''">true</_WrsSelfContainedPreparer>
      <_WrsPreparationPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)wrs-prepare-publish\$(RuntimeIdentifier)\'))</_WrsPreparationPublishDir>
    </PropertyGroup>

    <Copy SourceFiles="@(_WrsAampReaderFiles)" DestinationFiles="@(_WrsAampReaderFiles->'$(PublishDir)aampreader\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy Condition="'$(_WrsSelfContainedPreparer)' != 'true'" SourceFiles="@(_WrsPreparationFiles)" DestinationFiles="@(_WrsPreparationFiles->'$(PublishDir)wrs-prepare\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <MSBuild Condition="'$(_WrsSelfContainedPreparer)' == 'true'" Projects="$(WrsPreparationProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;_WrsRestoreEvaluation=true"
             RemoveProperties="PublishSingleFile;PublishDir;OutDir;OutputPath;_IsPublishing" />
    <MSBuild Condition="'$(_WrsSelfContainedPreparer)' == 'true'" Projects="$(WrsPreparationProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=false;PublishDir=$(_WrsPreparationPublishDir)"
             RemoveProperties="OutDir;OutputPath;_IsPublishing" />
    <ItemGroup Condition="'$(_WrsSelfContainedPreparer)' == 'true'">
      <_WrsPreparationPublished Include="$(_WrsPreparationPublishDir)**\*" />
    </ItemGroup>
    <Copy Condition="'$(_WrsSelfContainedPreparer)' == 'true'" SourceFiles="@(_WrsPreparationPublished)" DestinationFiles="@(_WrsPreparationPublished->'$(PublishDir)wrs-prepare\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
