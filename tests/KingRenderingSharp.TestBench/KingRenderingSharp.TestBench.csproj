<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KingRenderingSharp\KingRenderingSharp.csproj" />
    <ProjectReference Include="..\..\src\KingRenderingSharp.Preparation\KingRenderingSharp.Preparation.csproj" />
  </ItemGroup>

  <!-- The preparer this runs in its own process looks for the pack tool beside it, as krs-pack. -->
  <Target Name="KrsCopyPackToolForBench" AfterTargets="Build">
    <ItemGroup>
      <_KrsPackFiles Include="$(MSBuildThisFileDirectory)..\..\src\KingRenderingSharp.Preparation\bin\$(Configuration)\$(TargetFramework)\krs-pack\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_KrsPackFiles)" DestinationFiles="@(_KrsPackFiles->'$(OutDir)krs-pack\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
