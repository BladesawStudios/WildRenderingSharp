<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The OFFLINE half: turns an actor or model in the user's own romfs into the cache the renderer
    reads (geometry, textures, skeleton/anims, material UBOs, the manifest, and the decompiled
    shader programs it names), plus the shared system assets every model needs.

    Usable two ways:
      - referenced as a library, through ModelPreparer / InProcessPreparer;
      - run as a child process (this is an Exe), through the core library's OutOfProcessPreparer,
        by a host that cannot load ShaderLibrary's vendored BfresLibrary build beside its own.

    All the real work is ShaderLibrary.CompileTool's - this project only sequences it, records
    which romfs files each preparation read (so mods invalidate it), and installs the shared assets.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Preparing allocates over a hundred megabytes a model across a dozen threads; one heap per core paused it a fifth less. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Description>Prepares Breath of the Wild / Tears of the Kingdom actors from a romfs into a WildRenderingSharp cache.</Description>
    <!-- The vendored ShaderLibrary is the default; point this at another checkout to build against that. -->
    <WrsShaderLibraryDir Condition="'$(WrsShaderLibraryDir)' == ''">$(MSBuildThisFileDirectory)..\..\vendor\ShaderLibrary</WrsShaderLibraryDir>
  </PropertyGroup>

  <Target Name="WrsCheckShaderLibrary" BeforeTargets="CollectPackageReferences;CoreCompile" Condition="!Exists('$(WrsShaderLibraryDir)\ShaderLibrary.CompileTool\ShaderLibrary.CompileTool.csproj')">
    <Error Code="WRS0001" Text="WildRenderingSharp.Preparation builds against the ShaderLibrary submodule, and $(WrsShaderLibraryDir) is empty. Run: git submodule update --init --recursive" />
  </Target>

  <Target Name="WrsCheckPtclSharp" BeforeTargets="CollectPackageReferences;CoreCompile" Condition="!Exists('$(MSBuildThisFileDirectory)..\..\vendor\PtclSharp\lib\ZstdSharp\src\ZstdSharp\ZstdSharp.csproj')">
    <Error Code="WRS0002" Text="WildRenderingSharp.Preparation builds against the PtclSharp submodule and the libraries it reads effect files with, and they are empty. Run: git submodule update --init vendor/PtclSharp; git -C vendor/PtclSharp submodule update --init lib/ZstdSharp lib/BymlSharp lib/Yaz0Sharp" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WildRenderingSharp\WildRenderingSharp.csproj" />
    <ProjectReference Include="$(WrsShaderLibraryDir)\ShaderLibrary.CompileTool\ShaderLibrary.CompileTool.csproj" />
  </ItemGroup>

  <!-- The BFRES reader ShaderLibrary builds against; the asset readers here hand its ResFile to the exporters. -->
  <ItemGroup>
    <Reference Include="BfresLibrary">
      <HintPath>$(WrsShaderLibraryDir)\ShaderLibrary.CompileTool\Libs\Bfres\BfresLibrary.dll</HintPath>
    </Reference>
    <Reference Include="Syroot.Maths">
      <HintPath>$(WrsShaderLibraryDir)\ShaderLibrary.CompileTool\Libs\Bfres\Syroot.Maths.dll</HintPath>
    </Reference>
    <Reference Include="Syroot.BinaryData">
      <HintPath>$(WrsShaderLibraryDir)\ShaderLibrary.CompileTool\Libs\Bfres\Syroot.BinaryData.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The VFXB/ESETB reader particle effects are read through. Its BFRES-dependent half (PtclSharp.Models) stays out: ShaderLibrary's BfresLibrary build is the one in this process. -->
  <ItemGroup>
    <ProjectReference Include="..\..\vendor\PtclSharp\src\PtclSharp\PtclSharp.csproj" />
  </ItemGroup>

  <!-- The managed BNTX reader, with its own Tegra deswizzle. -->
  <ItemGroup>
    <ProjectReference Include="..\..\vendor\BntxSharp\src\BntxSharp\BntxSharp.csproj" />
  </ItemGroup>

</Project>
