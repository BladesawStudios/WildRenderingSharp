<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/KingRenderingSharp.Layer.props" />


  <PropertyGroup>
    <Description>The Breath of the Wild side of the renderer: its bindings, uniform blocks, shader sources and frame graph.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Glsl\**\*" LogicalName="Glsl/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Shaders\*.cs" LogicalName="Patch/Botw/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KingRenderingSharp.Graph\KingRenderingSharp.Graph.csproj" />
  </ItemGroup>
</Project>
