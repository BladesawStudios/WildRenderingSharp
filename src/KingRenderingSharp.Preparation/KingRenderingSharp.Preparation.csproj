<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The OFFLINE half: turns an actor or model in the user's own romfs into the cache the renderer
    reads (geometry, textures, skeleton/anims, material UBOs, the manifest, and the decompiled
    shader programs it names), plus the shared system assets every model needs.

    Usable two ways:
      - referenced as a library, through ModelPreparer / InProcessPreparer;
      - run as a child process (this is an Exe), through the core library's OutOfProcessPreparer,
        by a host whose own BfresLibrary build would clash with the one ShaderLibrary builds against.

    All the real work is ShaderLibrary.CompileTool's - this project only sequences it, records
    which romfs files each preparation read (so mods invalidate it), and installs the shared assets.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Preparing allocates over a hundred megabytes a model across a dozen threads; one heap per core paused it a fifth less. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Description>Prepares Breath of the Wild / Tears of the Kingdom actors from a romfs into a KingRenderingSharp cache.</Description>
    <!-- The vendored libraries are the default; point KrsLibRoot, or KrsShaderLibraryDir alone, at other checkouts to build against those. -->
    <KrsLibRoot Condition="'$(KrsLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\vendor</KrsLibRoot>
    <KrsShaderLibraryDir Condition="'$(KrsShaderLibraryDir)' == ''">$(KrsLibRoot)\ShaderLibrary</KrsShaderLibraryDir>
    <KrsBfresLibraryDir>$(KrsShaderLibraryDir)\..\BfresLibrary</KrsBfresLibraryDir>
    <!-- Where PtclSharp reads ZstdSharp, BymlSharp and Yaz0Sharp from: its PtclLibRoot when one is set, its own lib otherwise. -->
    <KrsPtclLibRoot>$(PtclLibRoot)</KrsPtclLibRoot>
    <KrsPtclLibRoot Condition="'$(KrsPtclLibRoot)' == ''">$(KrsLibRoot)\PtclSharp\lib</KrsPtclLibRoot>
  </PropertyGroup>

  <Target Name="KrsCheckShaderLibrary" BeforeTargets="CollectPackageReferences;CoreCompile" Condition="!Exists('$(KrsShaderLibraryDir)\ShaderLibrary.CompileTool\ShaderLibrary.CompileTool.csproj')">
    <Error Code="KRS0001" Text="KingRenderingSharp.Preparation builds against the ShaderLibrary submodule, and $(KrsShaderLibraryDir) is empty. Run: git submodule update --init --recursive" />
  </Target>

  <Target Name="KrsCheckBfresLibrary" BeforeTargets="CollectPackageReferences;CoreCompile" Condition="!Exists('$(KrsBfresLibraryDir)\BfresLibrary\BfresLibrary.csproj')">
    <Error Code="KRS0003" Text="KingRenderingSharp.Preparation builds against the BfresLibrary beside ShaderLibrary, and $(KrsBfresLibraryDir) is empty. Run: git submodule update --init --recursive" />
  </Target>

  <Target Name="KrsCheckPtclSharp" BeforeTargets="CollectPackageReferences;CoreCompile" Condition="!Exists('$(KrsLibRoot)\PtclSharp\src\PtclSharp\PtclSharp.csproj') Or !Exists('$(KrsPtclLibRoot)\ZstdSharp\src\ZstdSharp\ZstdSharp.csproj')">
    <Error Code="KRS0002" Text="KingRenderingSharp.Preparation builds against PtclSharp in $(KrsLibRoot)\PtclSharp and the libraries it reads effect files with in $(KrsPtclLibRoot), and one of them is empty. Run: git submodule update --init --recursive" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\KingRenderingSharp\KingRenderingSharp.csproj" />
    <ProjectReference Include="$(KrsShaderLibraryDir)\ShaderLibrary.CompileTool\ShaderLibrary.CompileTool.csproj" />
  </ItemGroup>

  <!-- The BFRES reader ShaderLibrary builds against, which is the one beside it; the asset readers here hand its ResFile to the exporters. -->
  <ItemGroup>
    <ProjectReference Include="$(KrsBfresLibraryDir)\BfresLibrary\BfresLibrary.csproj" />
    <Reference Include="Syroot.Maths">
      <HintPath>$(KrsBfresLibraryDir)\Libraries\Syroot.Maths.dll</HintPath>
    </Reference>
    <Reference Include="Syroot.BinaryData">
      <HintPath>$(KrsBfresLibraryDir)\Libraries\Syroot.BinaryData.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The VFXB/ESETB reader particle effects are read through. -->
  <ItemGroup>
    <ProjectReference Include="$(KrsLibRoot)\PtclSharp\src\PtclSharp\PtclSharp.csproj" />
  </ItemGroup>

  <!-- The managed BNTX reader, with its own Tegra deswizzle. -->
  <ItemGroup>
    <ProjectReference Include="$(KrsLibRoot)\BntxSharp\src\BntxSharp\BntxSharp.csproj" />
  </ItemGroup>

</Project>
