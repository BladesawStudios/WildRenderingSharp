<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/KingRenderingSharp.Layer.props" />


  <!--
    The host-facing renderer: KingRenderer, the views and offscreen targets a host displays, background content
    loading, the model preparers and per-actor posing. The layers it draws with are the projects it references.

    Parses no BFRES/BFSHA of its own. Everything it draws comes from a cache written by
    KingRenderingSharp.Packing, which OutOfProcessPreparer runs as a child process.
  -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Renders Breath of the Wild / Tears of the Kingdom models with the games' own decompiled shaders through a deferred OpenGL pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the context handle a host gives the background loader; the GL API itself stays behind the Gpu project. -->
    <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
    <ProjectReference Include="..\KingRenderingSharp.Games.Totk\KingRenderingSharp.Games.Totk.csproj" />
    <ProjectReference Include="..\KingRenderingSharp.Games.Botw\KingRenderingSharp.Games.Botw.csproj" />
  </ItemGroup>

</Project>
